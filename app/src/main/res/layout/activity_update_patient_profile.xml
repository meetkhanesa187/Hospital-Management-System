<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    tools:context=".UpdatePatientProfileActivity">

    <!-- Top-right icon -->
    <ImageView
        android:id="@+id/ivTopRightButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_logout"
        android:contentDescription="Top Right Button" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation"
        android:layout_below="@id/ivTopRightButton"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/logo"
                android:contentDescription="App Logo"
                android:layout_marginTop="65dp"
                android:layout_marginBottom="20dp" />

            <!-- Update Profile Header -->
            <TextView
                android:id="@+id/tvUpdateProfileHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Profile"
                android:textSize="28sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:fontFamily="serif" />

            <!-- Full Name -->
            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:padding="12dp"
                android:background="@drawable/rounded_edittext"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp" />

            <!-- Email (Read-only) -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:padding="12dp"
                android:background="@drawable/rounded_edittext"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:enabled="false"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp" />

            <!-- Mobile Number -->
            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mobile Number"
                android:padding="12dp"
                android:background="@drawable/rounded_edittext"
                android:inputType="phone"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp" />

            <!-- Age -->
            <EditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Age"
                android:padding="12dp"
                android:background="@drawable/rounded_edittext"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:minHeight="50dp"
                android:layout_marginBottom="12dp" />

            <!-- Update Profile Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Profile"
                android:background="@drawable/rounded_button"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Generate QR Code Button -->
            <Button
                android:id="@+id/btnGenerateQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate QR Code"
                android:backgroundTint="#6200EE"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- QR Code Display -->
            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:visibility="gone"
                android:layout_gravity="center"
                android:contentDescription="QR Code"
                android:layout_marginBottom="16dp" />

            <!-- Download QR Code Button -->
            <Button
                android:id="@+id/btnDownloadQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download QR Code"
                android:backgroundTint="@color/black"
                android:textColor="@android:color/white"
                android:padding="12dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Give Feedback"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EEDFE6ED"
        android:padding="12dp"
        android:gravity="center"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:id="@+id/news_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_news"
                android:contentDescription="News Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="News"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/doctor_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="32dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_doctor"
                android:contentDescription="Doctor Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/articles_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="32dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_article"
                android:contentDescription="Articles Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favorite_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="32dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_heart"
                android:contentDescription="Favorite Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorite"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="32dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/profile"
                android:contentDescription="Profile Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
