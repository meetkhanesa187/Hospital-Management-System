<resources>
    <!-- Default Slot Button Style -->
    <style name="SlotButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/tab_selector</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <!-- Selected Slot Button Style -->
    <style name="SlotSelected">
        <item name="android:background">@drawable/slot_selected</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
